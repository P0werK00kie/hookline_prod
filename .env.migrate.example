# Settings for `npm run migrate` (scripts/migrate-from-cloud.ts).
# Copy to .env.migrate (gitignored) and fill in.

# --- Source: Appwrite Cloud -------------------------------------------------
# Same as VITE_APPWRITE_URL in your .env.local, e.g. https://cloud.appwrite.io/v1
SOURCE_ENDPOINT=https://cloud.appwrite.io/v1
SOURCE_PROJECT_ID=
# Cloud console > Project > Overview > API keys. Scopes: users.read,
# databases.read, collections.read, attributes.read, indexes.read,
# documents.read, buckets.read, files.read
SOURCE_API_KEY=

# --- Target: self-hosted Appwrite in the Portainer stack -------------------
# Endpoint this machine uses to reach the stack.
TARGET_ENDPOINT=http://192.168.1.50:7071/v1
# Defaults to SOURCE_PROJECT_ID. Create the local project with this same ID.
TARGET_PROJECT_ID=
# Local console > Project > API keys. Scopes: users.write, users.read,
# databases.write, databases.read, collections.write, collections.read,
# attributes.write, attributes.read, indexes.write, indexes.read,
# documents.write, documents.read, buckets.write, buckets.read,
# files.write, files.read
TARGET_API_KEY=
# Endpoint browsers use; stored image URLs are rewritten to this.
# Defaults to TARGET_ENDPOINT.
TARGET_PUBLIC_ENDPOINT=
# Must match APPWRITE_STORAGE_LIMIT in the stack (bytes).
TARGET_STORAGE_LIMIT=30000000

# --- Optional filters -------------------------------------------------------
# Comma-separated IDs; empty = everything.
DATABASE_IDS=
BUCKET_IDS=
SKIP_USERS=false
SKIP_FILES=false
