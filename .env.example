# Appwrite Configuration
# Get these values from your Appwrite console: https://cloud.appwrite.io/

# Appwrite API Endpoint (e.g., https://cloud.appwrite.io/v1)
VITE_APPWRITE_URL=

# Your Appwrite Project ID
VITE_APPWRITE_PROJECT_ID=

# Your Appwrite Database ID
VITE_APPWRITE_DATABASE_ID=

# Your Appwrite Storage Bucket ID (for user uploads)
VITE_APPWRITE_STORAGE_ID=

# Collection ID for Users collection
VITE_APPWRITE_USER_COLLECTION_ID=

# Collection ID for Posts collection
VITE_APPWRITE_POST_COLLECTION_ID=

# Collection ID for Saves collection
VITE_APPWRITE_SAVES_COLLECTION_ID=
