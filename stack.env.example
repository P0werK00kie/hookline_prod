# Portainer stack variables for docker-compose.yml.
# In Portainer: Stacks > Add stack > Environment variables > "Load variables from .env file"
# (or paste them one by one). Do NOT commit a filled-in copy of this file.

# --- Host / ports -----------------------------------------------------------
# LAN IP or hostname browsers use to reach the Portainer host.
APP_HOST=192.168.1.50
WEB_PORT=7070
APPWRITE_PORT=7071

# --- Appwrite secrets (generate once, keep forever) -------------------------
# openssl rand -hex 32
APPWRITE_OPENSSL_KEY=
# openssl rand -hex 16
APPWRITE_DB_PASS=
# openssl rand -hex 16
APPWRITE_DB_ROOT_PASS=

# Only the first console signup is allowed while this is enabled.
APPWRITE_CONSOLE_WHITELIST_ROOT=enabled

# Optional SMTP (password resets / verification). Leave blank to disable.
APPWRITE_SMTP_HOST=
APPWRITE_SMTP_PORT=
APPWRITE_SMTP_SECURE=
APPWRITE_SMTP_USERNAME=
APPWRITE_SMTP_PASSWORD=
APPWRITE_SYSTEM_EMAIL_ADDRESS=noreply@hookline.local

# --- App IDs -----------------------------------------------------------------
# The migration script keeps the Appwrite Cloud IDs, so copy these straight
# from your existing .env.local (VITE_APPWRITE_* values).
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_STORAGE_ID=
APPWRITE_USER_COLLECTION_ID=
APPWRITE_POST_COLLECTION_ID=
APPWRITE_SAVES_COLLECTION_ID=

# --- hookline-api (roles, Writers Block connections) -------------------------
# Server API key created in the local Appwrite console (Project > API keys) with
# scopes: users.read, users.write, databases.read, databases.write,
# collections.read, collections.write, attributes.read, attributes.write,
# indexes.read, indexes.write, documents.read, documents.write
HOOKLINE_API_KEY=
# Comma-separated emails that get the Admin role when they sign in.
ADMIN_EMAILS=
